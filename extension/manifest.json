{
  "manifest_version": 3,
  "name": "Autodiscography Vault — Phase B2",
  "version": "0.3.0",
  "description": "Local-first Suno witness with explicit one-track pilot transport into exact local admission.",
  "permissions": ["sidePanel"],
  "optional_permissions": ["downloads"],
  "action": {
    "default_title": "Open Autodiscography Vault"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/*",
        "https://www.suno.com/*"
      ],
      "js": [
        "src/provider/suno/live-observer.js",
        "src/provider/suno/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
